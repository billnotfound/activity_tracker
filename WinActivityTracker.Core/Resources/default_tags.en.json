[
  { "_comment": "=== Tag Rule Format ===" },
  { "_comment": "tag: category name (e.g. Coding, Gaming, Video)" },
  { "_comment": "process: process name (optional), case-insensitive, e.g. devenv.exe" },
  { "_comment": "titlePattern: window title wildcard (optional), * matches any chars, e.g. *YouTube*" },
  { "_comment": "weight: priority weight (integer), higher wins, default 0" },
  { "_comment": "mode: coexist or overwrite, default coexist" },
  { "_comment": "" },
  { "_comment": "=== Resolution Rules ===" },
  { "_comment": "Coexist + Coexist -> all take effect (all coexist tags at max weight returned together)" },
  { "_comment": "Overwrite + Overwrite -> higher weight wins (first-in-file breaks ties)" },
  { "_comment": "Coexist + Overwrite -> higher weight decides (coexist wins tiebreaker)" },
  { "_comment": "" },
